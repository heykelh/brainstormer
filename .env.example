# Copie ce fichier en .env et remplis les valeurs. Ne commite JAMAIS le .env.

# Obligatoire pour l'extraction (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modèle utilisé pour l'extraction (Haiku = rapide et peu cher)
BRAINSTORMER_MODEL=claude-haiku-5-5

# Optionnel mais recommandé : passe la limite GitHub de 10 à 30 requêtes/min sur la recherche
# Token "fine-grained" en lecture seule, aucune permission nécessaire : https://github.com/settings/tokens
GITHUB_TOKEN=

# Fenêtre de collecte en jours
BRAINSTORMER_LOOKBACK_DAYS=14

# Nombre d'idées dans le digest
BRAINSTORMER_DIGEST_SIZE=5

# Ton profil : sert au score d'adéquation fondateur/idée
BRAINSTORMER_FOUNDER_PROFILE="Data engineer et consultant gouvernance data/IA (AI Act, RGPD). Stack Python, FastAPI, Next.js, Supabase. 13 ans dans le ferroviaire. Développeur solo, temps partiel."

# Optionnel : notification push via ntfy.sh (laisse vide pour désactiver)
NTFY_TOPIC=
